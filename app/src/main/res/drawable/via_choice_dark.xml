<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false">
        <shape>
            <stroke android:width="2.0dp" android:color="@color/via_control_stroke" />
            <solid android:color="@android:color/transparent" />
            <corners android:radius="16.0dp" />
            <size android:height="16.0dp" android:width="16.0dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/via_accent_dark" />
            <corners android:radius="16.0dp" />
            <size android:height="16.0dp" android:width="16.0dp" />
        </shape>
    </item>
</selector>
