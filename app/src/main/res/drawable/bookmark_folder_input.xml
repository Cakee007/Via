<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_enabled="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="@dimen/menu_corner_radius" />
                    <solid android:color="@color/control_ripple_color" />
                </shape>
            </item>
            <item android:left="-2.0dp" android:top="-2.0dp" android:right="-2.0dp">
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1.0dp" android:color="@color/via_control_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="-2.0dp" android:top="-2.0dp" android:right="-2.0dp">
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1.0dp" android:color="@color/via_control_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
