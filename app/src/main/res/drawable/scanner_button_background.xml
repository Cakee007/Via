<?xml version="1.0" encoding="utf-8"?>
<!-- x7.o.c / original drawable e: 40dp circles inside the 48dp controls. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_pressed="false">
        <shape android:shape="oval">
            <size android:width="40dp" android:height="40dp" />
            <solid android:color="#20ffffff" />
            <stroke android:width="1dp" android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:state_selected="false" android:state_pressed="true">
        <shape android:shape="oval">
            <size android:width="40dp" android:height="40dp" />
            <solid android:color="#20ffffff" />
            <stroke android:width="1dp" android:color="#20ffffff" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <shape android:shape="oval">
            <size android:width="40dp" android:height="40dp" />
            <solid android:color="@android:color/white" />
            <stroke android:width="1dp" android:color="@android:color/white" />
        </shape>
    </item>
</selector>
