<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="via_dialog_scrollbar_thumb">#80808080</color>
    <style name="Via.Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowBackground">?attr/viaDialogBackground</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/Via.Dialog.Animation</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="Via.Dialog.Animation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/via_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/via_dialog_exit</item>
    </style>
    <style name="Via.Dialog.Text" parent="">
        <item name="android:textSize">14sp</item><item name="android:textColor">?attr/viaPrimaryTextColor</item><item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Via.Dialog.SecondaryText" parent="">
        <item name="android:textSize">12sp</item><item name="android:textColor">?attr/viaSecondaryTextColor</item>
    </style>
    <style name="Via.Dialog.Title" parent="">
        <item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:textColor">?attr/viaPrimaryTextColor</item><item name="android:ellipsize">end</item><item name="android:maxLines">1</item><item name="android:lines">1</item>
        <item name="android:paddingTop">8dp</item><item name="android:paddingBottom">8dp</item><item name="android:layout_marginLeft">16dp</item><item name="android:layout_marginRight">16dp</item><item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="Via.Dialog.Button" parent="">
        <item name="android:textSize">14sp</item><item name="android:textColor">#6f8de1</item><item name="android:gravity">center</item><item name="android:background">@drawable/rounded_rect_ripple</item><item name="android:minWidth">56dp</item><item name="android:ellipsize">end</item><item name="android:padding">16dp</item><item name="android:lines">1</item>
    </style>
    <style name="Via.Dialog.Scroll" parent="">
        <item name="android:scrollbarSize">3dp</item><item name="android:scrollbarThumbVertical">@color/via_dialog_scrollbar_thumb</item><item name="android:scrollbarTrackVertical">@android:color/transparent</item><item name="android:scrollbars">vertical</item><item name="android:overScrollMode">never</item>
    </style>
</resources>
