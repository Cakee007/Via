<?xml version="1.0" encoding="utf-8"?>
<!-- e9.k / original layout r: the slider is above the control cells. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <SeekBar android:id="@+id/home_custom_slider" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="24dp" android:layout_marginRight="24dp" android:paddingLeft="0dp" android:paddingRight="0dp"
        android:paddingTop="9dp" android:paddingBottom="12dp" android:thumbOffset="0dp" android:visibility="gone"
        android:layout_above="@id/home_custom_controls" style="@style/Seekbar" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_custom_controls" android:layout_width="match_parent"
        android:layout_height="96dp" android:paddingBottom="12dp" android:layout_alignParentBottom="true" />
</RelativeLayout>
