<?xml version="1.0" encoding="utf-8"?>
<!-- Original layout e: mark.via.download.m uses this entire custom-layout dialog. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/download_confirmation_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dialog_download" android:textDirection="locale" style="@style/Via.Dialog.Title" />
    <HorizontalScrollView android:id="@+id/download_filename_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:layout_below="@id/download_confirmation_title" style="@style/Password.Dialog.InputScroll">
        <EditText android:id="@+id/download_filename" android:layout_width="wrap_content" android:layout_height="wrap_content" android:hint="@string/file_name" android:inputType="textUri|textNoSuggestions" android:imeOptions="actionDone" android:textDirection="locale" style="@style/Password.Dialog.Input" />
    </HorizontalScrollView>
    <TextView android:id="@+id/download_size" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginBottom="12dp" android:minLines="1" android:layout_below="@id/download_filename_scroll" style="@style/Via.Dialog.SecondaryText" />
    <TextView android:id="@+id/download_confirmation_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@android:string/ok" android:layout_below="@id/download_size" android:layout_alignParentEnd="true" style="@style/Via.Dialog.Button" />
    <TextView android:id="@+id/download_confirmation_copy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_copy" android:layout_alignTop="@id/download_confirmation_ok" android:layout_alignParentStart="true" style="@style/Via.Dialog.Button" />
    <TextView android:id="@+id/download_confirmation_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@android:string/cancel" android:layout_toStartOf="@id/download_confirmation_ok" android:layout_alignTop="@id/download_confirmation_ok" style="@style/Via.Dialog.Button" />
</RelativeLayout>
