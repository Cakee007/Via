<?xml version="1.0" encoding="utf-8"?>
<!-- Original layout s: qa.o's second ViewPager2 page. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/favorite_back" android:background="@drawable/rounded_rect_ripple"
        android:padding="13dp" android:layout_width="48dp" android:layout_height="48dp"
        android:src="@drawable/favorite_back" android:tint="?attr/viaSubtleColor" android:contentDescription="@android:string/cancel" />
    <TextView android:id="@+id/favorite_heading" android:gravity="center" android:textSize="16sp" android:textStyle="bold"
        android:textColor="?attr/viaPrimaryTextColor" android:maxLines="1" android:lines="1" android:ellipsize="end"
        android:layout_width="match_parent" android:layout_height="0dp" android:text="@string/title_edit_favorite"
        android:layout_toStartOf="@id/favorite_done" android:layout_toEndOf="@id/favorite_back"
        android:layout_alignTop="@id/favorite_back" android:layout_alignBottom="@id/favorite_back" android:textDirection="locale" />
    <TextView android:id="@+id/favorite_done" android:gravity="center" android:background="@drawable/rounded_rect_ripple"
        android:textSize="14sp" android:textColor="@color/via_accent_light" android:minWidth="56dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/done"
        android:layout_alignTop="@id/favorite_heading" android:layout_alignBottom="@id/favorite_heading" android:layout_alignParentEnd="true" />
    <ImageView android:id="@+id/favorite_icon" android:layout_width="42dp" android:layout_height="42dp"
        android:layout_marginStart="16dp" android:layout_marginTop="8dp" android:layout_below="@id/favorite_heading"
        android:contentDescription="@string/desc_favorite_icon" />
    <ImageView android:id="@+id/favorite_icon_clear" android:padding="5dp" android:visibility="gone"
        android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="-8dp" android:layout_marginEnd="-8dp"
        android:src="@drawable/favorite_delete_badge" android:tint="#55ffffff" android:alpha="0.8"
        android:layout_alignTop="@id/favorite_icon" android:layout_alignEnd="@id/favorite_icon" android:contentDescription="@string/action_delete" />
    <EditText android:id="@+id/favorite_title" style="@style/Favorite.Input" android:hint="@string/hint_title"
        android:layout_toEndOf="@id/favorite_icon" android:layout_below="@id/favorite_heading"
        android:inputType="textNoSuggestions" android:imeOptions="actionNext" android:textDirection="locale" />
    <EditText android:id="@+id/favorite_url" style="@style/Favorite.Input" android:hint="@string/hint_url"
        android:layout_toEndOf="@id/favorite_icon" android:layout_below="@id/favorite_title"
        android:inputType="textUri|textNoSuggestions" android:imeOptions="actionDone" />
</RelativeLayout>
