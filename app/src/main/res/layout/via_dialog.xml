<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <Space android:layout_width="0dp" android:layout_height="12dp" />
    <TextView android:id="@+id/dialog_title" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textDirection="locale" style="@style/Via.Dialog.Title" />
    <ScrollView android:id="@+id/dialog_message_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Via.Dialog.Scroll">
        <TextView android:id="@+id/dialog_message" android:paddingLeft="16dp" android:paddingTop="8dp" android:paddingRight="16dp" android:paddingBottom="8dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" android:textDirection="locale" style="@style/Via.Dialog.Text" />
    </ScrollView>
    <dev.ujhhgtg.via.ui.dialog.MaxHeightLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <ListView android:id="@+id/dialog_list" android:visibility="gone" android:fadingEdge="vertical" android:fadingEdgeLength="32dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:listSelector="@android:color/transparent" android:divider="@android:color/transparent" android:requiresFadingEdge="vertical" style="@style/Via.Dialog.Scroll" />
    </dev.ujhhgtg.via.ui.dialog.MaxHeightLayout>
    <FrameLayout android:id="@+id/dialog_custom" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/dialog_check_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_marginRight="16dp">
        <CheckBox android:layout_gravity="center_vertical" android:id="@+id/dialog_check" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:button="?attr/viaChoiceIndicator" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/dialog_check_label" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:textDirection="locale" style="@style/Via.Dialog.SecondaryText" />
    </LinearLayout>
    <Space android:layout_width="0dp" android:layout_height="12dp" />
    <LinearLayout android:gravity="end" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/dialog_neutral" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Via.Dialog.Button" />
        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/dialog_negative" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Via.Dialog.Button" />
        <TextView android:id="@+id/dialog_positive" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Via.Dialog.Button" />
    </LinearLayout>
</LinearLayout>
