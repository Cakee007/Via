<?xml version="1.0" encoding="UTF-8"?>
<!--
  Warnings listed here describe behavior copied verbatim from the original Via APK. Fixing them would make
  the reconstruction diverge, so they are recorded here instead of changed in the code.
-->
<lint>
    <!-- The original layouts use android:tint and the app inflates them with the platform ImageView;
         app:tint is only honored by AppCompat views, which this app does not use. -->
    <issue id="UseAppTint" severity="ignore" />

    <!-- Security posture mirrors the original: cleartext and user CAs are allowed (network_security.xml),
         the CustomTabsConnectionService is exported without a permission, and WebViewClients do not
         handle onRenderProcessGone. The download trust-all manager carries a FIXME in DownloadNetwork.kt. -->
    <issue id="AcceptsUserCertificates" severity="ignore" />
    <issue id="InsecureBaseConfiguration" severity="ignore" />
    <issue id="ExportedService" severity="ignore" />
    <issue id="MissingOnRenderProcessGone" severity="ignore" />
    <issue id="CustomX509TrustManager" severity="ignore" />
    <issue id="TrustAllX509TrustManager" severity="ignore" />

    <!-- Adapters refresh whole lists and rows concatenate counters/units exactly as the original does. -->
    <issue id="NotifyDataSetChanged" severity="ignore" />
    <issue id="SetTextI18n" severity="ignore" />
    <!-- Original layouts keep dp text sizes, autofill defaults, touch handling and accessibility focus. -->
    <issue id="SpUsage" severity="ignore" />
    <issue id="Autofill" severity="ignore" />
    <issue id="ClickableViewAccessibility" severity="ignore" />
    <issue id="AccessibilityFocus" severity="ignore" />
    <issue id="ContentDescription" severity="ignore" />
    <issue id="TextFields" severity="ignore" />
    <issue id="HardcodedText" severity="ignore" />
    <issue id="UselessParent" severity="ignore" />
    <issue id="ViewConstructor" severity="ignore" />

    <!-- Translation catalogs are kept verbatim from upstream (Via's i18n repository). -->
    <issue id="Typos" severity="ignore" />
    <issue id="TypographyEllipsis" severity="ignore" />
    <issue id="PluralsCandidate" severity="ignore" />
    <issue id="StringFormatCount" severity="ignore" />
    <issue id="UnusedQuantity" severity="ignore" />
    <issue id="MissingQuantity" severity="ignore" />
    <issue id="UnusedTranslation" severity="ignore" />
    <!-- Keep the official Hindi catalog verbatim; its unused set_to_default key contains "% s". -->
    <issue id="StringFormatInvalid">
        <ignore path="src/main/res/values-hi/strings.xml" regexp=".*set_to_default.*" />
    </issue>

    <!-- The original ships the same bitmap under several names and both XML and PNG variants of an icon. -->
    <issue id="IconDuplicates" severity="ignore" />
    <issue id="IconXmlAndPng" severity="ignore" />

    <!-- Original API usage and build choices. -->
    <issue id="WebViewApiAvailability" severity="ignore" />
    <issue id="AppBundleLocaleChanges" severity="ignore" />
    <issue id="PictureInPictureIssue" severity="ignore" />
    <issue id="UnusedAttribute" severity="ignore" />
    <!-- dynamicanimation stays at the original's 1.0.0 (see SettingsRecyclerView). -->
    <issue id="GradleDependency">
        <ignore regexp="androidx.dynamicanimation" />
    </issue>
</lint>
